local function getPlayerColor(plr)
    if plr.Team then
        return plr.Team.TeamColor.Color
    end
    return Color3.fromRGB(255, 255, 255)
end

local function getPlayerHeight(plr)
    if not plr.Character then return 5 end
    local humanoid = plr.Character:FindFirstChild("Humanoid")
    if humanoid then
        return humanoid.HipHeight or 5
    end
    return 5
end

local function createESPDrawing(plr)
    if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local hrp = plr.Character.HumanoidRootPart
    local head = plr.Character:FindFirstChild("Head") or hrp
    local torso = plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("UpperTorso") or hrp
    
    if not espLines[plr.UserId] then
        espLines[plr.UserId] = {}
    end
    if not espTexts[plr.UserId] then
        espTexts[plr.UserId] = {}
    end
    
    local color = getPlayerColor(plr)
    local height = getPlayerHeight(plr)
    
    -- BOX ESP (Boy'a göre)
    if espBox then
        if not espLines[plr.UserId].box then
            local box = Drawing.new("Square")
            box.Visible = true
            box.Color = color
            box.Thickness = 1.5
            box.Filled = false
            box.Transparency = 1
            espLines[plr.UserId].box = box
        end
    else
        if espLines[plr.UserId] and espLines[plr.UserId].box then
            espLines[plr.UserId].box:Destroy()
            espLines[plr.UserId].box = nil
        end
    end
    
    -- TRACER
    if espTracer then
        if not espLines[plr.UserId].tracer then
            local tracer = Drawing.new("Line")
            tracer.Visible = true
            tracer.Color = color
            tracer.Thickness = 1.5
            tracer.Transparency = 1
            espLines[plr.UserId].tracer = tracer
        end
    else
        if espLines[plr.UserId] and espLines[plr.UserId].tracer then
            espLines[plr.UserId].tracer:Destroy()
            espLines[plr.UserId].tracer = nil
        end
    end
    
    -- SKELETON
    if espSkeleton then
        if not espLines[plr.UserId].skeleton then
            local parts = {}
            local jointPositions = {
                {"Head", "UpperTorso"},
                {"UpperTorso", "LowerTorso"},
                {"UpperTorso", "LeftUpperArm"},
                {"LeftUpperArm", "LeftLowerArm"},
                {"UpperTorso", "RightUpperArm"},
                {"RightUpperArm", "RightLowerArm"},
                {"LowerTorso", "LeftUpperLeg"},
                {"LeftUpperLeg", "LeftLowerLeg"},
                {"LowerTorso", "RightUpperLeg"},
                {"RightUpperLeg", "RightLowerLeg"},
            }
            
            for _, joint in ipairs(jointPositions) do
                local line = Drawing.new("Line")
                line.Visible = true
                line.Color = color
                line.Thickness = 1.5
                line.Transparency = 0.8
                table.insert(parts, line)
            end
            espLines[plr.UserId].skeleton = parts
        end
    else
        if espLines[plr.UserId] and espLines[plr.UserId].skeleton then
            for _, line in ipairs(espLines[plr.UserId].skeleton) do
                line:Destroy()
            end
            espLines[plr.UserId].skeleton = nil
        end
    end
    
    -- NAME ESP
    if espName then
        if not espTexts[plr.UserId].name then
            local text = Drawing.new("Text")
            text.Visible = true
            text.Color = color
            text.Size = 14
            text.Center = true
            text.Outline = true
            text.OutlineColor = Color3.fromRGB(0, 0, 0)
            text.Transparency = 1
            text.Font = 2
            espTexts[plr.UserId].name = text
        end
    else
        if espTexts[plr.UserId] and espTexts[plr.UserId].name then
            espTexts[plr.UserId].name:Destroy()
            espTexts[plr.UserId].name = nil
        end
    end
    
    -- HEALTH ESP
    if espHealth then
        if not espTexts[plr.UserId].health then
            local health = Drawing.new("Text")
            health.Visible = true
            health.Color = Color3.fromRGB(0, 255, 100)
            health.Size = 12
            health.Center = true
            health.Outline = true
            health.OutlineColor = Color3.fromRGB(0, 0, 0)
            health.Transparency = 1
            health.Font = 2
            espTexts[plr.UserId].health = health
        end
    else
        if espTexts[plr.UserId] and espTexts[plr.UserId].health then
            espTexts[plr.UserId].health:Destroy()
            espTexts[plr.UserId].health = nil
        end
    end
    
    -- DISTANCE ESP
    if espDistance then
        if not espTexts[plr.UserId].distance then
            local dist = Drawing.new("Text")
            dist.Visible = true
            dist.Color = Color3.fromRGB(255, 255, 255)
            dist.Size = 11
            dist.Center = true
            dist.Outline = true
            dist.OutlineColor = Color3.fromRGB(0, 0, 0)
            dist.Transparency = 1
            dist.Font = 2
            espTexts[plr.UserId].distance = dist
        end
    else
        if espTexts[plr.UserId] and espTexts[plr.UserId].distance then
            espTexts[plr.UserId].distance:Destroy()
            espTexts[plr.UserId].distance = nil
        end
    end
end

local function updateESP()
    local char = player.Character
    local localHrp = char and char:FindFirstChild("HumanoidRootPart")
    local viewport = camera.ViewportSize
    
    if not espBox and not espTracer and not espName and not espHealth and not espDistance and not espSkeleton then
        for userId, lines in pairs(espLines) do
            for key, line in pairs(lines) do
                if type(line) == "table" then
                    for _, l in ipairs(line) do l:Destroy() end
                else
                    line:Destroy()
                end
            end
        end
        espLines = {}
        for userId, texts in pairs(espTexts) do
            for key, text in pairs(texts) do
                text:Destroy()
            end
        end
        espTexts = {}
        return
    end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
            if espLines[plr.UserId] then
                for _, line in pairs(espLines[plr.UserId]) do
                    if type(line) == "table" then
                        for _, l in ipairs(line) do l:Destroy() end
                    else
                        line:Destroy()
                    end
                end
                espLines[plr.UserId] = nil
            end
            if espTexts[plr.UserId] then
                for _, text in pairs(espTexts[plr.UserId]) do
                    text:Destroy()
                end
                espTexts[plr.UserId] = nil
            end
            continue
        end
        
        local hrp = plr.Character.HumanoidRootPart
        local head = plr.Character:FindFirstChild("Head") or hrp
        local torso = plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("UpperTorso") or hrp
        
        createESPDrawing(plr)
        
        local color = getPlayerColor(plr)
        local height = getPlayerHeight(plr)
        local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
        local headPos, _ = camera:WorldToViewportPoint(head.Position)
        
        if not onScreen then
            if espLines[plr.UserId] then
                if espLines[plr.UserId].box then espLines[plr.UserId].box.Visible = false end
                if espLines[plr.UserId].tracer then espLines[plr.UserId].tracer.Visible = false end
                if espLines[plr.UserId].skeleton then
                    for _, line in ipairs(espLines[plr.UserId].skeleton) do
                        line.Visible = false
                    end
                end
            end
            if espTexts[plr.UserId] then
                if espTexts[plr.UserId].name then espTexts[plr.UserId].name.Visible = false end
                if espTexts[plr.UserId].health then espTexts[plr.UserId].health.Visible = false end
                if espTexts[plr.UserId].distance then espTexts[plr.UserId].distance.Visible = false end
            end
            continue
        end
        
        local distance = localHrp and (hrp.Position - localHrp.Position).Magnitude or 0
        local humanoid = plr.Character:FindFirstChild("Humanoid")
        local health = humanoid and humanoid.Health or 0
        local maxHealth = humanoid and humanoid.MaxHealth or 100
        local healthPercent = maxHealth > 0 and health / maxHealth or 0
        
        -- BOX ESP (Boy'a göre)
        if espBox and espLines[plr.UserId] and espLines[plr.UserId].box then
            local box = espLines[plr.UserId].box
            local scale = 30 / (distance / 10 + 1)
            local boxHeight = height * 2.5 * scale
            local boxWidth = height * 1.2 * scale
            box.Size = Vector2.new(boxWidth, boxHeight)
            box.Position = Vector2.new(screenPos.X - boxWidth/2, screenPos.Y - boxHeight/2)
            box.Color = color
            box.Visible = true
        end
        
        -- TRACER
        if espTracer and espLines[plr.UserId] and espLines[plr.UserId].tracer then
            local tracer = espLines[plr.UserId].tracer
            local center = Vector2.new(viewport.X / 2, viewport.Y)
            tracer.From = center
            tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            tracer.Color = color
            tracer.Visible = true
        end
        
        -- SKELETON
        if espSkeleton and espLines[plr.UserId] and espLines[plr.UserId].skeleton then
            local parts = espLines[plr.UserId].skeleton
            local jointMap = {
                {"Head", "UpperTorso"},
                {"UpperTorso", "LowerTorso"},
                {"UpperTorso", "LeftUpperArm"},
                {"LeftUpperArm", "LeftLowerArm"},
                {"UpperTorso", "RightUpperArm"},
                {"RightUpperArm", "RightLowerArm"},
                {"LowerTorso", "LeftUpperLeg"},
                {"LeftUpperLeg", "LeftLowerLeg"},
                {"LowerTorso", "RightUpperLeg"},
                {"RightUpperLeg", "RightLowerLeg"},
            }
            
            for i, joint in ipairs(jointMap) do
                local p1 = plr.Character:FindFirstChild(joint[1])
                local p2 = plr.Character:FindFirstChild(joint[2])
                if p1 and p2 and parts[i] then
                    local pos1, _ = camera:WorldToViewportPoint(p1.Position)
                    local pos2, _ = camera:WorldToViewportPoint(p2.Position)
                    parts[i].From = Vector2.new(pos1.X, pos1.Y)
                    parts[i].To = Vector2.new(pos2.X, pos2.Y)
                    parts[i].Visible = true
                end
            end
        end
        
        -- NAME ESP
        if espName and espTexts[plr.UserId] and espTexts[plr.UserId].name then
            local text = espTexts[plr.UserId].name
            text.Text = plr.Name
            text.Position = Vector2.new(screenPos.X, screenPos.Y - height * 2.5 * (30 / (distance/10 + 1)) / 2 - 20)
            text.Color = color
            text.Visible = true
        end
        
        -- HEALTH ESP
        if espHealth and espTexts[plr.UserId] and espTexts[plr.UserId].health then
            local healthText = espTexts[plr.UserId].health
            local healthColor = healthPercent > 0.5 and Color3.fromRGB(0, 255, 100) or 
                               healthPercent > 0.25 and Color3.fromRGB(255, 255, 0) or 
                               Color3.fromRGB(255, 0, 0)
            healthText.Text = string.format("%.0f", health) .. " HP"
            healthText.Position = Vector2.new(screenPos.X, screenPos.Y + height * 2.5 * (30 / (distance/10 + 1)) / 2 + 10)
            healthText.Color = healthColor
            healthText.Visible = true
        end
        
        -- DISTANCE ESP
        if espDistance and espTexts[plr.UserId] and espTexts[plr.UserId].distance then
            local distText = espTexts[plr.UserId].distance
            distText.Text = string.format("%.0fm", distance)
            distText.Position = Vector2.new(screenPos.X, screenPos.Y + height * 2.5 * (30 / (distance/10 + 1)) / 2 + 30)
            distText.Visible = true
        end
    end
end

