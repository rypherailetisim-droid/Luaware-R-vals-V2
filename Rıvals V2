    local mainStroke = Instance.new("UIStroke", mainFrame)
    mainStroke.Color = theme.stroke
    mainStroke.Thickness = 1.5

    isMenuOpen = true
    toggleBtn.MouseButton1Click:Connect(function()
        isMenuOpen = not isMenuOpen
        mainFrame.Visible = isMenuOpen
        toggleBtn.TextColor3 = isMenuOpen and theme.accent or Color3.fromRGB(255, 50, 50)
        toggleStroke.Color = isMenuOpen and theme.accent or Color3.fromRGB(255, 50, 50)
    end)

    -- Arka Plan Partikülleri
    local particleContainer = Instance.new("Frame")
    particleContainer.Size = UDim2.new(1, 0, 1, 0)
    particleContainer.BackgroundTransparency = 1
    particleContainer.ZIndex = 11
    particleContainer.Parent = mainFrame

    local function spawnMenuParticle()
        task.spawn(function()
            while true do
                task.wait(math.random(3, 8) / 10)
                if not mainFrame.Visible then continue end
                local size = math.random(3, 6)
                local startX = math.random()
                
                local particle = Instance.new("Frame")
                particle.Size = UDim2.new(0, size, 0, size)
                particle.Position = UDim2.new(startX, 0, 1.1, 0)
                particle.BackgroundColor3 = theme.accent
                particle.BackgroundTransparency = 0.4
                particle.ZIndex = 11
                particle.Parent = particleContainer
                Instance.new("UICorner", particle).CornerRadius = UDim.new(1, 0)

                local duration = math.random(6, 12)
                local drift = math.random(-15, 15) / 100
                local endPos = UDim2.new(startX + drift, 0, -0.2, 0)

                local tMovement = TweenService:Create(particle, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Position = endPos, BackgroundTransparency = 1})
                tMovement:Play()
                tMovement.Completed:Wait()
                particle:Destroy()
            end
        end)
    end
    for i = 1, 15 do spawnMenuParticle() end

    -- Üst Bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 45)
    titleBar.BackgroundTransparency = 1
    titleBar.ZIndex = 15
    titleBar.Parent = mainFrame

    local titleTxt = Instance.new("TextLabel")
    titleTxt.Size = UDim2.new(1, -20, 1, 0)
    titleTxt.Position = UDim2.new(0, 20, 0, 0)
    titleTxt.BackgroundTransparency = 1
    titleTxt.Text = "NonxTr Premium V1"
