local function toggleInvisibility()
    if not player.Character then
        warn("Character not found")
        return
    end

    isInvisible = not isInvisible

    if isInvisible then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            warn("HumanoidRootPart not found")
            return
        end

        local savedPos = hrp.CFrame
        local invisPos = Vector3.new(-25.95, 84, 3537.55)

        player.Character:MoveTo(invisPos)
        task.wait(0.15)

        invisChair = Instance.new("Seat")
        invisChair.Name = "invischair"
        invisChair.Anchored = false
        invisChair.CanCollide = false
        invisChair.Transparency = 1
        invisChair.Position = invisPos
        invisChair.Parent = workspace

        invisWeld = Instance.new("Weld")
        invisWeld.Part0 = invisChair
        invisWeld.Part1 = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
        invisWeld.Parent = invisChair

        task.wait()
        invisChair.CFrame = savedPos

        for _, obj in ipairs(player.Character:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") then
                obj.Transparency = 0.5
            end
        end

        StarterGui:SetCore("SendNotification", {
            Title = "Gorunmezlik ACIK",
            Text = "Artik gorunmezsin!",
            Duration = 3,
        })
    else
        if invisChair then
            invisChair:Destroy()
            invisChair = nil
        end
        if invisWeld then
            invisWeld:Destroy()
            invisWeld = nil
        end

        if player.Character then
            for _, obj in ipairs(player.Character:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") then
                    obj.Transparency = 0
                end
            end
        end

        StarterGui:SetCore("SendNotification", {
            Title = "Gorunmezlik KAPALI",
            Text = "Artik gorunursun!",
            Duration = 3,
        })
    end
end

