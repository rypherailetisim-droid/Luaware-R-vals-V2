-- ==========================================
-- getClosestPlayer (Aimbot için)
-- ==========================================
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local char = player.Character
    local localHrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not localHrp then return nil end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            if teamCheckEnabled and (plr.Team == player.Team or plr.TeamColor == player.TeamColor) then continue end
            
            local targetPart = plr.Character:FindFirstChild(aimTargetPart) or plr.Character:FindFirstChild("HumanoidRootPart")
            if not targetPart then continue end
            
            local distance = (targetPart.Position - localHrp.Position).Magnitude
            if distance > maxDistance then continue end
            
            if wallCheckEnabled then
                local rayParams = RaycastParams.new()
                rayParams.FilterDescendantsInstances = {char, plr.Character}
                rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                local rayResult = workspace:Raycast(localHrp.Position, (targetPart.Position - localHrp.Position), rayParams)
                if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
                    if not rayResult.Instance:IsDescendantOf(plr.Character) then continue end
                end
            end
            
            local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                local mouseDistance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                
                local maxRadius = FOVcircle and FOVcircle.Radius or 130
                if mouseDistance <= maxRadius then
                    if mouseDistance < shortestDistance then
                        shortestDistance = mouseDistance
                        closestPlayer = plr
                    end
                end
            end
        end
    end
    return closestPlayer
end

