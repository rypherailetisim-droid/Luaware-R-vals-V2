RunService.RenderStepped:Connect(function()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local localHrp = char and char:FindFirstChild("HumanoidRootPart")

    if hum then
        if cs and hum.WalkSpeed ~= cs then hum.WalkSpeed = cs end
        if cj and hum.JumpPower ~= cj then hum.UseJumpPower = true; hum.JumpPower = cj end
    end
    
    if ncE and char then
        for _,p in pairs(char:GetChildren()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    
    -- WALL WALK (Su üstünde yürüme)
    if wwE and localHrp and hum then
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {char}
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        
        local rayOrigin = localHrp.Position
        local rayDirection = Vector3.new(0, -1, 0) * 3
        local rayResult = workspace:Raycast(rayOrigin, rayDirection, rayParams)
        
        if rayResult then
            local hitPos = rayResult.Position
            local distanceToGround = (rayOrigin.Y - hitPos.Y)
            
            -- Yere yakınsa normal yürü, uzaksa uç (su üstü)
            if distanceToGround > 2 then
                local newPos = Vector3.new(localHrp.Position.X, hitPos.Y + 1.5, localHrp.Position.Z)
                localHrp.CFrame = CFrame.new(newPos, newPos + localHrp.CFrame.LookVector)
                hum.WalkSpeed = 16
            else
                hum.WalkSpeed = cs or 16
            end
        else
            -- Yer yoksa (su üstünde)
            hum.WalkSpeed = 16
        end
    end
 
    if aimbotEnabled and localHrp then
        local target = getClosestPlayer()
        if target and target.Character then
            local targetPart = target.Character:FindFirstChild(aimTargetPart)
            if targetPart then
                camera.CFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
            end
        end
        
        if FOVcircle then
            local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
            FOVcircle.Position = screenCenter
            hue = (hue + 1) % 360
            FOVcircle.Color = Color3.fromHSV(hue/360, 1, 1)
            FOVcircle.Visible = true
        end
    else
        if FOVcircle then FOVcircle.Visible = false end
    end
    
    updateESP()
end)

